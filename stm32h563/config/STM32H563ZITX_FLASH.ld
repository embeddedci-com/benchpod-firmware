/* Entry Point */
ENTRY(Reset_Handler)

/* Highest address of the user mode stack */
_estack = ORIGIN(RAM) + LENGTH(RAM); /* end of "RAM" Ram type memory */

_Min_Heap_Size = 0x200; /* required amount of heap */
_Min_Stack_Size = 0x400; /* required amount of stack */

/* Memories definition */
/* The 2 MB main flash is split into two regions so `make flash-dfu-code` can
 * rewrite just the firmware without re-sending the ~1.3 MB of embedded blobs
 * (ESP32-C3 slave image + iCE40 bitstreams) over slow USB-FS DFU each edit:
 *   FLASH       — code, rodata, data-init      (0x08000000, 640K)
 *   FLASH_BLOBS — embedded .blobs region        (0x080A0000, 1344K)
 * The 0x080A0000 blob base is mirrored by DFU_BLOBS_ADDR in the Makefile — keep
 * the two in sync. FLASH_BLOBS deliberately stops at 0x081F0000, below the
 * high-flash persistence sectors touched at runtime (OTA self-test scratch
 * 0x081F0000 in ota_commit.c, config 0x081FE000 in config_store.h), so the link
 * fails if the blobs ever grow into them. Two regions also give a free guard:
 * the link fails with "region FLASH overflowed" if the firmware exceeds 640K. */
MEMORY
{
  RAM         (xrw)   : ORIGIN = 0x20000000,   LENGTH = 640K
  FLASH       (rx)    : ORIGIN = 0x08000000,   LENGTH = 640K
  FLASH_BLOBS (r)     : ORIGIN = 0x080A0000,   LENGTH = 1344K
}

/* Sections */
SECTIONS
{
  /* The startup code into "FLASH" Rom type memory */
  .isr_vector :
  {
    . = ALIGN(4);
    KEEP(*(.isr_vector)) /* Startup code */
    . = ALIGN(4);
  } >FLASH

  /* The program code and other data into "FLASH" Rom type memory */
  .text :
  {
    . = ALIGN(4);
    *(.text)           /* .text sections (code) */
    *(.text*)          /* .text* sections (code) */
    *(.glue_7)         /* glue arm to thumb code */
    *(.glue_7t)        /* glue thumb to arm code */
    *(.eh_frame)

    KEEP (*(.init))
    KEEP (*(.fini))

    . = ALIGN(4);
    _etext = .;        /* define a global symbols at end of code */
  } >FLASH

  /* Constant data into "FLASH" Rom type memory */
  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)         /* .rodata sections (constants, strings, etc.) */
    *(.rodata*)        /* .rodata* sections (constants, strings, etc.) */
    . = ALIGN(4);
  } >FLASH

  /* Large embedded binary blobs — the ESP32-C3 esp-hosted slave image
   * (src/esp_slave_fw.s → .blob_esp_slave_fw) and the iCE40 bitstream(s)
   * (build/fpga_bitstream.h arrays → .blob_fpga) — kept out of .rodata and
   * collected here into the dedicated FLASH_BLOBS region. They rarely change,
   * so `make flash-dfu-code` can re-flash the firmware without them, while
   * `make flash-dfu-blobs` writes just this region after a gateware rebuild.
   * KEEP guards against --gc-sections dropping an unreferenced image. */
  .blobs :
  {
    . = ALIGN(4);
    _blobs_start = .;
    KEEP(*(.blob_esp_slave_fw))
    KEEP(*(.blob_esp_slave_fw*))
    KEEP(*(.blob_fpga))
    KEEP(*(.blob_fpga*))
    . = ALIGN(4);
    _blobs_end = .;
  } >FLASH_BLOBS

  .ARM.extab (READONLY) : /* The READONLY keyword is only supported in GCC11 and later, remove it if using GCC10 or earlier. */
  {
    . = ALIGN(4);
    *(.ARM.extab* .gnu.linkonce.armextab.*)
    . = ALIGN(4);
  } >FLASH

  .ARM (READONLY) : /* The READONLY keyword is only supported in GCC11 and later, remove it if using GCC10 or earlier. */
  {
    . = ALIGN(4);
    __exidx_start = .;
    *(.ARM.exidx*)
    __exidx_end = .;
    . = ALIGN(4);
  } >FLASH

  .preinit_array (READONLY) : /* The READONLY keyword is only supported in GCC11 and later, remove it if using GCC10 or earlier. */
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__preinit_array_start = .);
    KEEP (*(.preinit_array*))
    PROVIDE_HIDDEN (__preinit_array_end = .);
    . = ALIGN(4);
  } >FLASH

  .init_array (READONLY) : /* The READONLY keyword is only supported in GCC11 and later, remove it if using GCC10 or earlier. */
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__init_array_start = .);
    KEEP (*(SORT(.init_array.*)))
    KEEP (*(.init_array*))
    PROVIDE_HIDDEN (__init_array_end = .);
    . = ALIGN(4);
  } >FLASH

  .fini_array (READONLY) : /* The READONLY keyword is only supported in GCC11 and later, remove it if using GCC10 or earlier. */
  {
    . = ALIGN(4);
    PROVIDE_HIDDEN (__fini_array_start = .);
    KEEP (*(SORT(.fini_array.*)))
    KEEP (*(.fini_array*))
    PROVIDE_HIDDEN (__fini_array_end = .);
    . = ALIGN(4);
  } >FLASH

  /* Used by the startup to initialize data */
  _sidata = LOADADDR(.data);

  /* Initialized data sections into "RAM" Ram type memory */
  .data :
  {
    . = ALIGN(4);
    _sdata = .;        /* create a global symbol at data start */
    *(.data)           /* .data sections */
    *(.data*)          /* .data* sections */
    *(.RamFunc)        /* .RamFunc sections */
    *(.RamFunc*)       /* .RamFunc* sections */

    . = ALIGN(4);
    _edata = .;        /* define a global symbol at data end */

  } >RAM AT> FLASH

  /* Uninitialized data section into "RAM" Ram type memory */
  . = ALIGN(4);
  .bss :
  {
    /* This is used by the startup in order to initialize the .bss section */
    _sbss = .;         /* define a global symbol at bss start */
    __bss_start__ = _sbss;
    *(.bss)
    *(.bss*)
    *(COMMON)

    . = ALIGN(4);
    _ebss = .;         /* define a global symbol at bss end */
    __bss_end__ = _ebss;
  } >RAM

  /* No-init RAM: not loaded from flash, not zeroed by startup, so its contents
     survive a warm reset (NVIC_SystemReset).  Used by dfu_boot.c to carry the
     "reboot into DFU bootloader" flag across the reset. */
  .noinit (NOLOAD) :
  {
    . = ALIGN(4);
    _snoinit = .;
    *(.noinit)
    *(.noinit*)
    . = ALIGN(4);
    _enoinit = .;
  } >RAM

  /* User_heap_stack section, used to check that there is enough "RAM" Ram  type memory left */
  ._user_heap_stack :
  {
    . = ALIGN(8);
    PROVIDE ( end = . );
    PROVIDE ( _end = . );
    . = . + _Min_Heap_Size;
    . = . + _Min_Stack_Size;
    . = ALIGN(8);
  } >RAM

  /* Remove information from the compiler libraries */
  /DISCARD/ :
  {
    libc.a ( * )
    libm.a ( * )
    libgcc.a ( * )
  }

  .ARM.attributes 0 : { *(.ARM.attributes) }
}
