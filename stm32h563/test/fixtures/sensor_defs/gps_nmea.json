{"format":1,"kind":"uart","name":"gps_nmea","label":"GPS receiver: NMEA 0183 (u-blox style defaults)","description":"Prints RMC, VTG, GGA, GSA, GSV and GLL once per fix, like a NEO-6M/M8N out of the box. The\nposition moves along course at the set speed between fixes. The sky is synthetic but stable.\n","version":"1.0.0","license":"Apache-2.0","params":[{"key":"lat_deg","unit":"deg","min":-90,"max":90,"default":0,"label":"Latitude"},{"key":"lon_deg","unit":"deg","min":-180,"max":180,"default":0,"label":"Longitude"},{"key":"alt_m","unit":"m","min":-1000,"max":50000,"default":0,"label":"Altitude"},{"key":"speed_kmh","unit":"km/h","min":0,"max":2000,"default":0,"label":"Speed"},{"key":"course_deg","unit":"deg","min":0,"max":360,"default":0,"label":"Course"},{"key":"hdop","min":0,"max":99,"default":0.9},{"key":"sats","min":0,"max":12,"default":8,"label":"Satellites used"},{"key":"fix","min":0,"max":2,"default":1,"label":"Fix (0 none, 1 GPS, 2 DGPS)"},{"key":"utc_start","unit":"s","min":0,"max":4102444800,"default":1767225600,"label":"UTC at start (seconds since 1970)"},{"key":"rate_hz","unit":"Hz","min":1,"max":10,"default":1},{"key":"sentences","min":1,"max":63,"default":63,"label":"Sentence mask: RMC 1, VTG 2, GGA 4, GSA 8, GSV 16, GLL 32"}],"uart":{"baud":9600,"format":"8N1"},"state":[{"name":"lat","init":"lat_deg","update":"clamp(lat + speed_kmh / 3.6 * dt * cos(rad(course_deg)) / 111320, -90, 90)","follow":"lat_deg"},{"name":"lon","init":"lon_deg","update":"abs(cos(rad(lat))) > 1e-6 ? wrap180(lon + speed_kmh / 3.6 * dt * sin(rad(course_deg)) / (111320 * cos(rad(lat)))) : lon","follow":"lon_deg"}],"constants":{"KNOT":1.852},"let":[{"have":"fix != 0"},{"mode":"fix == 0 ? 'N' : fix == 2 ? 'D' : 'A'"},{"in_view":"min(have ? sats + 2 : 4, 12)"},{"gsv_msgs":"max(1, ceil(in_view / 4))"}],"functions":{"prn":{"args":["j"],"return":"[2, 5, 7, 9, 12, 13, 15, 18, 20, 23, 25, 29][j]"},"wrap180":{"args":["x"],"return":"x > 180 ? x - 360 : x < -180 ? x + 360 : x"}},"fragments":{"lat_f":{"text":"{have ? nmea_lat(lat) : ','}"},"lon_f":{"text":"{have ? nmea_lon(lon) : ','}"},"sat":{"args":["j"],"text":",{prn(j):02d},{15 + imod(j * 37, 70):02d},{imod(j * 97 + 20, 360):03d},{have ? 32 + imod(j * 7, 14) : '':02d}"},"gsa_prn":{"args":["j"],"text":",{have && j < sats ? prn(j) : '':02d}"}},"messages":[{"every_ms":"1000 / rate_hz","enabled":"bit(sentences, 0)","text":"$GPRMC,{hhmmss(utc)},{have ? 'A' : 'V'},{lat_f()},{lon_f()},{have ? speed_kmh / KNOT : '':.3f},{have ? course_deg : '':.2f},{ddmmyy(utc)},,,{mode}","end":"nmea"},{"every_ms":"1000 / rate_hz","enabled":"bit(sentences, 1)","text":"$GPVTG,{have ? course_deg : '':.2f},T,,M,{have ? speed_kmh / KNOT : '':.3f},N,{have ? speed_kmh : '':.3f},K,{mode}","end":"nmea"},{"every_ms":"1000 / rate_hz","enabled":"bit(sentences, 2)","text":"$GPGGA,{hhmmss(utc)},{lat_f()},{lon_f()},{fix:d},{have ? sats : 0:02d},{have ? hdop : '':.2f},{have ? alt_m : '':.1f}{have ? ',M,0.0,M,,' : ',,,,,'}","end":"nmea"},{"every_ms":"1000 / rate_hz","enabled":"bit(sentences, 3)","text":"$GPGSA,A,{have ? 3 : 1:d}{gsa_prn(0)}{gsa_prn(1)}{gsa_prn(2)}{gsa_prn(3)}{gsa_prn(4)}{gsa_prn(5)}{gsa_prn(6)}{gsa_prn(7)}{gsa_prn(8)}{gsa_prn(9)}{gsa_prn(10)}{gsa_prn(11)},{have ? hdop * 1.3 : 99.99:.2f},{have ? hdop : 99.99:.2f},{have ? hdop * 0.9 : 99.99:.2f},1","end":"nmea"},{"every_ms":"1000 / rate_hz","enabled":"bit(sentences, 4)","repeat":"gsv_msgs","text":"$GPGSV,{gsv_msgs:d},{i + 1:d},{in_view:02d}{i * 4 < in_view ? sat(i * 4) : ''}{i * 4 + 1 < in_view ? sat(i * 4 + 1) : ''}{i * 4 + 2 < in_view ? sat(i * 4 + 2) : ''}{i * 4 + 3 < in_view ? sat(i * 4 + 3) : ''},1","end":"nmea"},{"every_ms":"1000 / rate_hz","enabled":"bit(sentences, 5)","text":"$GPGLL,{lat_f()},{lon_f()},{hhmmss(utc)},{have ? 'A' : 'V'},{mode}","end":"nmea"}]}
