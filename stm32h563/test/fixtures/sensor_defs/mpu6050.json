{"format":1,"kind":"i2c","name":"mpu6050","label":"InvenSense MPU-6050: accelerometer and gyroscope","description":"Follows the measurement ranges, sleep and DEVICE_RESET the DUT writes. Scales from register map\nsections 4.17 to 4.19.\n","version":"1.0.0","license":"Apache-2.0","params":[{"key":"accel_x_g","unit":"g","min":-16,"max":16,"default":0},{"key":"accel_y_g","unit":"g","min":-16,"max":16,"default":0},{"key":"accel_z_g","unit":"g","min":-16,"max":16,"default":1},{"key":"gyro_x_dps","unit":"dps","min":-2000,"max":2000,"default":0},{"key":"gyro_y_dps","unit":"dps","min":-2000,"max":2000,"default":0},{"key":"gyro_z_dps","unit":"dps","min":-2000,"max":2000,"default":0},{"key":"temperature_c","unit":"C","min":-40,"max":85,"default":25}],"i2c":{"address":104,"alt_addresses":[105]},"let":[{"al":"[16384, 8192, 4096, 2048][bits(reg[0x1C], 4, 3)]"},{"gl":"[131, 65.5, 32.8, 16.4][bits(reg[0x1B], 4, 3)]"},{"asleep":"bit(reg[0x6B], 6)"},{"on":"asleep ? 0 : 1"}],"registers":[{"at":27,"u8":0,"name":"GYRO_CONFIG"},{"at":28,"u8":0,"name":"ACCEL_CONFIG"},{"at":58,"u8":"on","name":"INT_STATUS"},{"at":59,"s16be":"on * accel_x_g * al","name":"ACCEL_XOUT"},{"at":61,"s16be":"on * accel_y_g * al"},{"at":63,"s16be":"on * accel_z_g * al"},{"at":65,"s16be":"on * (temperature_c - 36.53) * 340","name":"TEMP_OUT"},{"at":67,"s16be":"on * gyro_x_dps * gl","name":"GYRO_XOUT"},{"at":69,"s16be":"on * gyro_y_dps * gl"},{"at":71,"s16be":"on * gyro_z_dps * gl"},{"at":107,"u8":64,"name":"PWR_MGMT_1"},{"at":117,"u8":104,"name":"WHO_AM_I","writable":false}],"on_write":[{"when":"reg[0x6B] & 0x80","do":"reset"}]}
