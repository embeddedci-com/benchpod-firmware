# BenchPod Wi-Fi bridge, development build (unlocked chip: no secure boot, no flash encryption).
# Production adds sdkconfig.defaults.production, see docs/SECURITY.md.
CONFIG_IDF_TARGET="esp32"
# WROOM-32E is ESP32 v3.x (ECO3); needed for RSA (secure boot v2 scheme) app signatures.
CONFIG_ESP32_REV_MIN_3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_APP_REPRODUCIBLE_BUILD=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# OTA: roll back to the previous image unless the new one marks itself valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Signed OTA images even on unlocked dev chips: the running app only accepts an update signed
# with the same RSA-3072 key (secure boot v2 signature block). build.sh creates a per-checkout
# dev key if there is none; production signs with the release key instead.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/dev_signing_key.pem"

# Wi-Fi: station only (no SoftAP code at all), credentials kept by our app in NVS only.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
# Throughput: more buffers and bigger block-ack windows than the defaults.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# Ethernet: internal EMAC, RMII.
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_DMA_RX_BUFFER_NUM=20
CONFIG_ETH_DMA_TX_BUFFER_NUM=20

# Factory/debug console on UART0 (Tag-Connect TC2030 pads; USB-C is power only), 115200 8N1.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
