[submodule "stm32h563/lib/FreeRTOS-Kernel"]
	path = stm32h563/lib/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "stm32h563/lib/stm32_mw_lwip"]
	path = stm32h563/lib/stm32_mw_lwip
	url = https://github.com/STMicroelectronics/stm32_mw_lwip.git
[submodule "stm32h563/lib/scpi-parser"]
