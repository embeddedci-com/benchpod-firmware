# vbench-pod ESP32-C3 (U4) esp-hosted slave — board-specific overrides.
# Symbol names verified against the slave's main/Kconfig.projbuild (registry
# esp_hosted 2.12.9). Only what differs from stock esp32c3 slave defaults:
#   HANDSHAKE  IO3 -> IO0  (host PB0)
#   DATA_READY IO4 -> IO1  (host PB1)
# Already correct by default: SPI full-duplex host interface, mode 3,
# MOSI=7, MISO=2, CLK=6, CS=10.
CONFIG_ESP_SPI_HOST_INTERFACE=y
CONFIG_ESP_SPI_GPIO_HANDSHAKE=0
CONFIG_ESP_SPI_GPIO_DATA_READY=1

# Without this, ESP-IDF embeds the compile date/time (__DATE__/__TIME__) into the
# app image header, so two builds of identical source at different times produce
# different bytes and `make fetch`'s sha256 check (build.sh / Makefile `fetch`)
# can never pass on a fresh rebuild — only a byte-for-byte copy of the committed
# blob. This is the file build.sh actually copies into the project (sdkconfig.defaults
# at repo top level is not read by the build — its settings just happen to already
# match the upstream template's defaults).
CONFIG_APP_REPRODUCIBLE_BUILD=y
